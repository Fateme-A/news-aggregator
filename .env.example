# Docker Compose reads this file. It is already in the project, so this is the
# place to put a key: save it, then `docker compose up`.
#
# The Guardian key is the easiest one. Register at the link below, paste it on
# GUARDIAN_KEY, and leave the other two blank if you want — a blank key keeps
# that provider on its recorded sample. Auto mode uses live data where a key
# is set and the sample otherwise.
#
# These values are read by nginx only. They are not exposed to client code and
# never appear in the JS bundle. For `npm run dev`, copy this file to
# .env.local (Vite does not load .env.example). .env.local overrides this file
# for Docker too, and it stays gitignored.

# https://open-platform.theguardian.com/access/   (5,000 req/day, 12 req/sec)
GUARDIAN_KEY=a5247be7-35c4-410f-b497-81078b2301c2

# https://developer.nytimes.com/   (500 req/day, 5 req/min — only the API key, not the secret)
NYT_KEY=P6WR56Zi0857399v2XPKeg7tkqVh6A2gtNIxJyOA0naMs71W

# https://newsapi.org/register   (100 req/day, 24h article delay)
NEWSAPI_KEY=6676010467374f88adc07fa44d1ebfd5
