# Copy to .env.local and fill in. Never commit .env.local.
# These are read by the Vite dev proxy / nginx only — they are NOT exposed to
# client code and never appear in the JS bundle.
#
# Leave a key blank to run that provider on recorded sample articles. The app
# starts in Auto, which uses live data where a key is set and the sample otherwise.

# https://open-platform.theguardian.com/access/   (5,000 req/day, 12 req/sec)
GUARDIAN_KEY=

# https://developer.nytimes.com/   (500 req/day, 5 req/min — only the API key, not the secret)
NYT_KEY=

# https://newsapi.org/register   (100 req/day, 24h article delay)
NEWSAPI_KEY=
